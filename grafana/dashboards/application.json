        "y": 0,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(webapp_http_requests_total{job=\"webapp\"}[1m]))",
          "legendFormat": "",
          "range": true,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
